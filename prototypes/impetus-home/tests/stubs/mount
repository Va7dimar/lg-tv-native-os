#!/bin/sh
# Stand-in for `mount --bind <src> <dst>` and `mount -o bind <src> <dst>`:
# the destination shows the source's content until umount puts it back.
# A file $STUB_TV/nomount makes every mount fail.
T=${STUB_TV:?}
[ -e "$T/nomount" ] && exit 1
while [ $# -gt 2 ]; do shift; done
[ -e "$1" ] && [ -e "$2" ] || exit 1
echo "mount $1 $2" >> "$T/calls"
cp "$2" "$T/mounted.saved" && echo "$2" > "$T/mounted.path" && cat "$1" > "$2"
