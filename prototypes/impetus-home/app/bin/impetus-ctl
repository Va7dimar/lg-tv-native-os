#!/bin/sh
# impetus-ctl: the root-side helper of Impetus Home (DESIGN.md, "How it runs").
#
# The page calls it through Homebrew Channel's exec service, one verb at a
# time:   sh <app dir>/bin/impetus-ctl <verb> [key=value ...]
# Every word is checked here again; anything outside the safe set is refused.
#
# Verbs
#   probe                 what works on this TV, as key=1|0 lines (changes nothing)
#   start [target=<id>]   put back anything a restart interrupted, start the keeper
#   state                 scene, timers and shield as key=value lines
#   still [nolive]        one line "kind=live|last|none age=<s>", then the JPG bytes
#   scene on id=.. [launch=..] [mode=..] [set=k:v,..] [night=k:v,..]
#            [nightstart=<epoch>] [end=<epoch>] [screenoff=<s>] [volmax=<n>] [sleep=<min>]
#   scene off             end the scene, put the TV back as it was
#   sleep cancel          drop the sleep timer; prints prev=<app that was in front>
#   shield on|off         block the hosts in shield/hosts.txt (memory only)
#   engine                vitals, state, connections and log in one answer
#   restore               the way back: scene off, shield off, keeper stopped
#   keeper | tick         the background loop, or one turn of it
#
# Files: /tmp/impetus (memory) and <app dir>/state (small files that must
# survive a restart: the picture values and volume from before a scene, and
# whether the shield is on). Nothing else is written. Never reboots; the
# sleep timer ends in a normal power-off.
#
# busybox ash and dash both run this file.

umask 022

APP=org.va7dimar.home
STOCK=com.webos.app.home
DIR=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)
RUN=${IMPETUS_RUN:-/tmp/impetus}
KEEP=${IMPETUS_KEEP:-$DIR/state}
ETC_HOSTS=${IMPETUS_ETC_HOSTS:-/etc/hosts}
HBC_HOSTS=${IMPETUS_HBC_HOSTS:-/tmp/hosts}
MOUNTINFO=${IMPETUS_MOUNTINFO:-/proc/self/mountinfo}
THERMAL=${IMPETUS_THERMAL:-/sys/class/thermal/thermal_zone0/temp}
LOGS=${IMPETUS_LOGS:-/var/log/legacy-log /var/log/messages /var/log/dbg-log}
DISK=${IMPETUS_DISK:-/media/developer}

# The TV's services. Each call was taken from community notes for webOS 6 and
# is confirmed (or corrected here) in the TV session; see TV-SESSION.md.
SAM=luna://com.webos.service.applicationmanager
SET=luna://com.webos.settingsservice
PWR=luna://com.webos.service.tvpower/power
AUD=luna://com.webos.service.audio/master
CAP=luna://com.webos.service.capture/executeOneShot
TOAST=luna://com.webos.notification/createToast

SINK4=127.66.66.66      # where blocked names go; nothing listens but the counter
SINK6=::1
STILL_MIN=2500          # a smaller JPG is a black frame
STILL_MAX=150000        # a larger one does not fit the exec answer
STILL_MAXAGE=${IMPETUS_STILL_MAXAGE:-21600}
NOTICE=120              # seconds of notice before standby
TRIES=20                # turns a put-back is tried again when the TV refuses it
FRONTWAIT=${IMPETUS_FRONTWAIT:-15}   # seconds `restore` waits for an app to come to the front
LUNAWAIT=${IMPETUS_LUNAWAIT:-10}     # seconds one call to the TV may take
LOCKWAIT=${IMPETUS_LOCKWAIT:-16}     # tries (about a second each) a verb waits for the lock
LOCKMAX=${IMPETUS_LOCKMAX:-120}      # seconds after which a lock is taken over though its holder runs

now() { if [ -n "$IMPETUS_NOW" ]; then echo "$IMPETUS_NOW"; else date +%s; fi; }

# ---------- checks ----------

safe() { case "$1" in ""|*[!A-Za-z0-9._:,=+@/-]*) return 1 ;; esac; return 0; }
safe_id() { case "$1" in ""|*[!A-Za-z0-9._-]*) return 1 ;; esac; return 0; }
# A plain whole number. A leading zero is refused: the shell's arithmetic
# would read it as octal.
is_num() { case "$1" in ""|*[!0-9]*|0?*) return 1 ;; esac; [ ${#1} -le 12 ]; }
is_int() { case "$1" in -*) is_num "${1#-}" ;; *) is_num "$1" ;; esac; }
pic_key() {
  case "$1" in backlight|contrast|brightness|color|sharpness|colorTemperature|energySaving) return 0 ;; esac
  return 1
}
pic_val() { case "$1" in ""|*[!A-Za-z0-9_-]*) return 1 ;; esac; [ ${#1} -le 24 ]; }
pairs_ok() {
  for p in $(echo "$1" | tr ',' ' '); do
    case "$p" in *:*) ;; *) return 1 ;; esac
    pic_key "${p%%:*}" && pic_val "${p#*:}" || return 1
  done
  return 0
}
die() { echo "error=$1"; exit 2; }
# An empty marker file. Not `: > file`: when the file cannot be written, a
# redirection on `:` ends the whole shell, with the lock still held.
mark() { { printf '' > "$1"; } 2>/dev/null; }

# ---------- luna ----------

# One call, one answer. A service that never answers is given up after
# $LUNAWAIT seconds: the call then counts as refused (no answer text). The
# watcher writes nowhere, so a caller reading the answer never waits for it.
luna() {
  (
    luna-send -n 1 "$1" "$2" 2>/dev/null </dev/null &
    ln_p=$!
    (
      trap 'kill "$ln_s" 2>/dev/null; exit 0' TERM
      sleep "$LUNAWAIT" & ln_s=$!
      wait "$ln_s" && kill "$ln_p" 2>/dev/null
    ) >/dev/null 2>&1 </dev/null &
    ln_w=$!
    wait "$ln_p"; ln_r=$?
    kill "$ln_w" 2>/dev/null
    exit "$ln_r"
  ) 2>/dev/null   # the shell's own note about a call it ended stays out of the answer
}
ok() { case "$1" in *'"returnValue":true'*|*'"returnValue": true'*) return 0 ;; esac; return 1; }
# The value of "key" in a JSON text on stdin (string or number). When a line
# holds the key twice, the last one is taken.
jget() { sed -n 's/.*"'"$1"'" *: *"\{0,1\}\([^",}]*\).*/\1/p' | head -n 1; }
jquoted() { grep -q '"'"$1"'" *: *"'; }

front_now() { luna "$SAM/getForegroundAppInfo" '{}' | jget appId; }
# What is in front: the follower's note when the keeper runs, else a direct ask.
front() {
  if [ -s "$RUN/front" ] && keeper_alive; then cat "$RUN/front"; else front_now; fi
}
launch() {
  if [ -n "$2" ]; then luna "$SAM/launch" "{\"id\":\"$1\",\"params\":$2}" >/dev/null
  else luna "$SAM/launch" "{\"id\":\"$1\"}" >/dev/null; fi
}

# ---------- lock (one state change at a time) ----------

# Shell variables are shared by every function in this file, so the helpers
# below keep to their own names (lk, pp_*, so_*, ap_*, am_*, rt_*, vr_*, ...).
#
# The lock is the symbolic link $RUN/lock, and what it points at names its
# holder: "pid.second" (seconds since the TV started). Making the link takes
# the lock and names the holder in one step. Only the holder removes it. A
# waiter takes it over when the holder is no longer running, when the lock is
# older than $LOCKMAX seconds, or when something without a holder's name has
# been in its place for 3 tries in a row.

# The pid of this shell. Not $$: in a background part ( ... ) & that is still
# the pid of the shell that started it, which may be gone already.
lock_me() { exec sh -c 'echo "$PPID"'; }
# Seconds since the TV started, into lk_now. Not the clock: it may jump when
# the TV gets the time from the network.
lock_now() {
  lk_now= lk_x=
  { read -r lk_now lk_x < /proc/uptime; } 2>/dev/null
  lk_now=${lk_now%%.*}
  is_num "$lk_now" || lk_now=$(date +%s)
}
lock_read() { ls -ld "$1" 2>/dev/null | sed -n 's/.* -> //p'; }

# True when the lock in place may be taken over. Leaves what it read in lk_v.
lock_stale() {
  lk_v=$(lock_read "$RUN/lock")
  lk_p=${lk_v%%.*}; lk_at=${lk_v#*.}
  if ! is_num "$lk_p"; then lk_none=$((lk_none + 1)); [ "$lk_none" -ge 3 ]; return; fi
  lk_none=0
  [ "$lk_p" = "$lk_me" ] && return 0          # left behind under this very pid
  kill -0 "$lk_p" 2>/dev/null || return 0
  is_num "$lk_at" || return 0
  lock_now
  [ $((lk_now - lk_at)) -gt "$LOCKMAX" ]
}

lock() {
  lk=0 lk_none=0
  lk_me=$(lock_me)
  is_num "$lk_me" || lk_me=$$
  while :; do
    lock_now
    if ln -s "$lk_me.$lk_now" "$RUN/lock" 2>/dev/null; then
      [ -L "$RUN/lock" ] && return 0
      rm -f "$RUN/lock/$lk_me.$lk_now"       # a folder sat in its place and took the link in
    fi
    lk=$((lk + 1))
    [ "$lk" -gt "$LOCKWAIT" ] && return 1    # held too long, /tmp full or read-only: go on without it
    if lock_stale; then
      # Moved aside in one step. If another waiter took it over first, what
      # was moved is their new lock: it goes back under the same name.
      rm -rf "$RUN/lock.old.$lk_me"
      if mv "$RUN/lock" "$RUN/lock.old.$lk_me" 2>/dev/null; then
        lk_q=$(lock_read "$RUN/lock.old.$lk_me")
        [ "$lk_q" = "$lk_v" ] || ln -s "$lk_q" "$RUN/lock" 2>/dev/null
        rm -rf "$RUN/lock.old.$lk_me"
      fi
      lk_none=0
      continue
    fi
    sleep 1
  done
}

# Only the holder's own lock is removed: a verb that went on without the
# lock, or lost it to a take-over, leaves the next holder's lock alone.
unlock() {
  [ -n "$lk_me" ] || return 0
  ul_v=$(lock_read "$RUN/lock")
  [ "${ul_v%%.*}" = "$lk_me" ] && rm -f "$RUN/lock"
  return 0
}

# ---------- picture ----------

pic_read() { luna "$SET/getSystemSettings" "{\"category\":\"picture\",\"keys\":[\"$1\"]}"; }
# pic_put key value quoted(1|0): written in the form it was read in.
pic_put() {
  pp_v=$2
  if [ "$3" = 1 ] || ! is_int "$2"; then pp_v="\"$2\""; fi
  pp_x=""
  [ "$1" = energySaving ] && pp_x=',"energySavingModified":"true"'
  ok "$(luna "$SET/setSystemSettings" "{\"category\":\"picture\",\"settings\":{\"$1\":$pp_v$pp_x}}")"
}

# Originals live in orig.<target>: "pic|key|value|quoted" and
# "mode|pictureMode|value|quoted". The copy in $KEEP survives a restart, and
# is written first: a value that cannot be written down is not changed.
save_orig() { # file kind key
  grep -q "^$2|$3|" "$1" 2>/dev/null && return 0
  so_r=$(pic_read "$3")
  ok "$so_r" || return 1
  so_v=$(printf '%s\n' "$so_r" | jget "$3")
  case "$so_v" in ""|*'|'*) return 1 ;; esac
  so_q=0; printf '%s\n' "$so_r" | jquoted "$3" && so_q=1
  so_b=${1##*/}
  mkdir -p "$KEEP" 2>/dev/null
  if { cat "$1" 2>/dev/null; echo "$2|$3|$so_v|$so_q"; } > "$KEEP/new.$so_b" 2>/dev/null &&
     mv "$KEEP/new.$so_b" "$KEEP/$so_b" 2>/dev/null; then
    echo "$2|$3|$so_v|$so_q" >> "$1"
  else
    rm -f "$KEEP/new.$so_b" 2>/dev/null
    return 1
  fi
}

apply_pairs() { # file pairs
  for ap_p in $(echo "$2" | tr ',' ' '); do
    ap_k=${ap_p%%:*}; ap_v=${ap_p#*:}
    pic_key "$ap_k" && pic_val "$ap_v" || continue
    save_orig "$1" pic "$ap_k" || continue
    ap_q=$(grep "^pic|$ap_k|" "$1" | head -n 1 | cut -d'|' -f4)
    pic_put "$ap_k" "$ap_v" "$ap_q"
  done
}

apply_mode() { # file mode
  save_orig "$1" mode pictureMode || return 1
  am_q=$(grep "^mode|pictureMode|" "$1" | head -n 1 | cut -d'|' -f4)
  pic_put pictureMode "$2" "$am_q" || return 1
  sleep 1   # the values read next belong to the new mode
}

# Put back what orig.<target> holds. Only called while <target> is in front,
# because picture values belong to the input that is showing. The record is
# dropped only when the TV took every value; otherwise it stays and the
# put-back waits (pending.<target>) for a later turn, $TRIES turns at most.
# After that the record still stays for the next scene end or `restore`.
restore_target() {
  rt_f="$RUN/orig.$1"
  if [ ! -s "$rt_f" ]; then rm -f "$rt_f" "$RUN/pending.$1" "$RUN/tries.$1" "$KEEP/orig.$1"; return 0; fi
  rt_bad=0
  for rt_pass in pic mode; do   # the values first, then the mode they belong to
    # The values belong to the scene's mode: while one of them is still
    # refused the mode stays, so a later try does not write them into the
    # mode from before.
    [ "$rt_bad" = 0 ] || break
    while IFS='|' read -r rt_t rt_k rt_v rt_q; do
      [ "$rt_t" = "$rt_pass" ] || continue
      # A refused write counts as done when the TV already holds the value
      # (a key this TV never takes was never changed in the first place).
      pic_put "$rt_k" "$rt_v" "$rt_q" ||
        [ "$(pic_read "$rt_k" | jget "$rt_k")" = "$rt_v" ] || rt_bad=1
    done < "$rt_f"
  done
  if [ "$rt_bad" = 0 ]; then rm -f "$rt_f" "$RUN/pending.$1" "$RUN/tries.$1" "$KEEP/orig.$1"; return 0; fi
  rt_n=$(cat "$RUN/tries.$1" 2>/dev/null); is_num "$rt_n" || rt_n=0
  rt_n=$((rt_n + 1))
  if [ "$rt_n" -ge "$TRIES" ]; then rm -f "$RUN/pending.$1" "$RUN/tries.$1"
  else echo "$rt_n" > "$RUN/tries.$1"; mark "$RUN/pending.$1"; fi
  return 1
}

# ---------- volume ----------

vol_read() { luna "$AUD/getVolume" '{}' | jget volume; }
vol_put() { ok "$(luna "$AUD/setVolume" "{\"volume\":$1}")"; }
# Put the volume back to what it was before a scene lowered it ("was set" in
# vol, mirrored in $KEEP). When the TV does not answer the record stays and
# the keeper tries again, $TRIES turns at most.
vol_restore() {
  # After a restart the record may only be on disk yet.
  [ -s "$RUN/vol" ] || cp "$KEEP/vol" "$RUN/vol" 2>/dev/null
  if [ ! -s "$RUN/vol" ]; then rm -f "$RUN/vol" "$RUN/vol.tries" "$KEEP/vol"; return 0; fi
  read -r vr_was vr_set < "$RUN/vol"
  vr_cur=$(vol_read)
  if is_num "$vr_cur"; then
    # Only when nobody touched the volume since the scene lowered it.
    if [ "$vr_cur" != "$vr_set" ] || ! is_num "$vr_was" || vol_put "$vr_was"; then
      rm -f "$RUN/vol" "$RUN/vol.tries" "$KEEP/vol"; return 0
    fi
  fi
  vr_n=$(cat "$RUN/vol.tries" 2>/dev/null); is_num "$vr_n" || vr_n=0
  vr_n=$((vr_n + 1))
  if [ "$vr_n" -ge "$TRIES" ]; then rm -f "$RUN/vol" "$RUN/vol.tries" "$KEEP/vol"
  else echo "$vr_n" > "$RUN/vol.tries"; fi
  return 1
}

# ---------- scenes ----------

scene_clear() {
  rm -f "$RUN"/scene.* "$RUN/sleep.until" "$RUN/sleep.noticed" "$RUN/sleep.prev" "$RUN/standby.tries" "$RUN/screenoff.at"
}

# End the active scene. Picture values go back now when the scene's target is
# in front; otherwise they wait (pending.<target>) until it is.
scene_off_locked() {
  t=$(cat "$RUN/scene.target" 2>/dev/null)
  scene_clear
  vol_restore
  if safe_id "$t" && [ -e "$RUN/orig.$t" ]; then
    if [ "$(front)" = "$t" ]; then restore_target "$t"; else mark "$RUN/pending.$t"; fi
  fi
}

# Work that waits for an app to be in front: pending restores, a scene's
# picture values, and its night values once the sun is down.
due() {
  f=$(front)
  safe_id "$f" || return 0
  [ -e "$RUN/pending.$f" ] && restore_target "$f"
  [ "$(cat "$RUN/scene.target" 2>/dev/null)" = "$f" ] || return 0
  o="$RUN/orig.$f"
  if [ -e "$RUN/scene.apply" ]; then
    rm -f "$RUN/scene.apply"
    m=$(cat "$RUN/scene.mode" 2>/dev/null)
    [ -n "$m" ] && apply_mode "$o" "$m"
    s=$(cat "$RUN/scene.set" 2>/dev/null)
    [ -n "$s" ] && apply_pairs "$o" "$s"
  fi
  if [ -s "$RUN/scene.night" ] && [ ! -e "$RUN/scene.night.done" ]; then
    ns=$(cat "$RUN/scene.nightstart" 2>/dev/null)
    if is_num "$ns" && [ "$(now)" -ge "$ns" ]; then
      mark "$RUN/scene.night.done"
      apply_pairs "$o" "$(cat "$RUN/scene.night")"
    fi
  fi
}

scene_on() {
  ID= LAUNCH= FALLBACK= MODE= SETP= NIGHT= NSTART= END= SOFF= VOLMAX= SLEEPM=
  for a in "$@"; do
    k=${a%%=*}; v=${a#*=}
    case "$k" in
      id) safe_id "$v" || die id; ID=$v ;;
      launch) [ "$v" = @last ] || safe_id "$v" || die launch; LAUNCH=$v ;;
      fallback) safe_id "$v" || die fallback; FALLBACK=$v ;;
      mode) pic_val "$v" || die mode; MODE=$v ;;
      set) pairs_ok "$v" || die set; SETP=$v ;;
      night) pairs_ok "$v" || die night; NIGHT=$v ;;
      nightstart) is_num "$v" || die nightstart; NSTART=$v ;;
      end) is_num "$v" || die end; END=$v ;;
      screenoff) is_num "$v" && [ "$v" -le 600 ] || die screenoff; SOFF=$v ;;
      volmax) is_num "$v" && [ "$v" -le 100 ] || die volmax; VOLMAX=$v ;;
      sleep) is_num "$v" && [ "$v" -ge 1 ] && [ "$v" -le 600 ] || die sleep; SLEEPM=$v ;;
      *) die "word" ;;
    esac
  done
  [ -n "$ID" ] || die id
  if [ -n "$NIGHT" ]; then is_num "$NSTART" && is_num "$END" || die night; fi
  mkdir -p "$RUN"
  keeper_ensure
  echo ok=1
  # The rest runs on its own: the page goes to the background when the
  # scene's app opens, and the exec call must not wait for it.
  ( scene_apply ) >/dev/null 2>&1 </dev/null &
}

scene_apply() {
  lock
  scene_off_locked
  t=$LAUNCH
  if [ "$t" = @last ]; then
    t=$(cat "$RUN/last" 2>/dev/null)
    safe_id "$t" || t=$FALLBACK
  fi
  n=$(now)
  echo "$ID" > "$RUN/scene.id"
  safe_id "$t" && echo "$t" > "$RUN/scene.target"
  [ -n "$END" ] && echo "$END" > "$RUN/scene.end"
  if [ -n "$MODE$SETP" ] && safe_id "$t"; then
    echo "$MODE" > "$RUN/scene.mode"; echo "$SETP" > "$RUN/scene.set"; mark "$RUN/scene.apply"
  fi
  if [ -n "$NIGHT" ] && safe_id "$t"; then
    echo "$NIGHT" > "$RUN/scene.night"; echo "$NSTART" > "$RUN/scene.nightstart"
  fi
  [ -n "$SLEEPM" ] && echo $((n + SLEEPM * 60)) > "$RUN/sleep.until"
  if [ -n "$VOLMAX" ]; then
    sa_cur=$(vol_read)
    if is_num "$sa_cur" && [ "$sa_cur" -gt "$VOLMAX" ]; then
      # Written down first, where it survives a restart, then lowered. A
      # record still waiting from an earlier scene keeps its older volume.
      sa_was=$sa_cur
      if [ -s "$RUN/vol" ]; then read -r sa_old sa_x < "$RUN/vol"; is_num "$sa_old" && sa_was=$sa_old; fi
      # A volume that cannot be written down is not lowered.
      if { mkdir -p "$KEEP" && echo "$sa_was $VOLMAX" > "$KEEP/vol.new" &&
           mv "$KEEP/vol.new" "$KEEP/vol"; } 2>/dev/null; then
        echo "$sa_was $VOLMAX" > "$RUN/vol"
        # A call that got no answer may still be carried out, so the record
        # stays; it is dropped later if the volume is not the one set here.
        vol_put "$VOLMAX"
      else
        rm -f "$KEEP/vol.new" 2>/dev/null
      fi
    fi
  fi
  if [ -n "$SOFF" ]; then
    echo $((n + SOFF)) > "$RUN/screenoff.at"
    [ "$SOFF" -ge 5 ] && luna "$TOAST" "{\"sourceId\":\"$APP\",\"message\":\"Screen off in $SOFF seconds\"}" >/dev/null
  fi
  unlock
  safe_id "$t" && launch "$t"
  # Picture values wait for the target to be in front; the keeper takes over
  # if that takes longer than this.
  i=0
  while [ "$i" -lt 15 ] && [ -e "$RUN/scene.apply" ]; do
    sleep 1; i=$((i + 1))
    if [ "$(front_now)" = "$t" ]; then
      echo "$t" > "$RUN/front"
      lock; due; unlock
    fi
  done
}

scene_off() { mkdir -p "$RUN"; lock; scene_off_locked; unlock; echo ok=1; }

# ---------- power ----------

screen_off() { ok "$(luna "$PWR/turnOffScreen" '{}')" || ok "$(luna "$PWR/turnOffScreen" '{"standbyMode":"active"}')"; }

# A normal power-off, as the remote's power key does. Never a reboot. The
# calls are tried in order until the TV accepts one.
standby() {
  ok "$(luna "$PWR/turnOff" '{"reason":"remoteKey"}')" && return 0
  ok "$(luna "$PWR/shutDown" '{"reason":"remoteKey"}')" && return 0
  ok "$(luna luna://com.webos.service.power/shutdown/machineOff '{"reason":"remoteKey"}')" && return 0
  return 1
}

# ---------- the still ----------

fsize() { [ -r "$1" ] && wc -c < "$1" | tr -d " "; }

capture() { # path
  rm -f "$1"
  r=$(luna "$CAP" "{\"path\":\"$1\",\"method\":\"DISPLAY\",\"format\":\"JPG\",\"width\":480,\"height\":270}")
  ok "$r" || return 1
  s=$(fsize "$1")
  is_num "$s" && [ "$s" -ge "$STILL_MIN" ] && [ "$s" -le "$STILL_MAX" ]
}

still() {
  mkdir -p "$RUN"
  if [ "$1" != nolive ] && capture "$RUN/live.jpg"; then
    echo "kind=live age=0"; cat "$RUN/live.jpg"; return 0
  fi
  at=$(cat "$RUN/last.at" 2>/dev/null)
  if is_num "$at" && [ -s "$RUN/last.jpg" ]; then
    age=$(( $(now) - at ))
    if [ "$age" -ge 0 ] && [ "$age" -le "$STILL_MAXAGE" ]; then
      echo "kind=last age=$age"; cat "$RUN/last.jpg"; return 0
    fi
  fi
  echo "kind=none age=0"
}

# The keeper keeps one still from the last time the target was in front.
still_keep() {
  t=$(cat "$RUN/still.target" 2>/dev/null)
  safe_id "$t" && [ "$(front)" = "$t" ] || return 0
  if capture "$RUN/last.new"; then
    mv "$RUN/last.new" "$RUN/last.jpg"; now > "$RUN/last.at"
  else
    rm -f "$RUN/last.new"
  fi
}

# ---------- shield ----------

MARK_A="# impetus-shield begin"
MARK_B="# impetus-shield end"

hosts_mounted() { grep -q " $ETC_HOSTS " "$MOUNTINFO" 2>/dev/null; }
same_text() { [ "$(cat "$1" 2>/dev/null)" = "$(cat "$2" 2>/dev/null)" ]; }

# A hosts file without our block, every line ending in a newline. A block
# that lost its closing marker (a cut-off write) is still taken out: after the
# opening marker only our own pairs of lines are dropped.
hosts_plain() {
  awk -v a="$MARK_A" -v b="$MARK_B" -v s4="$SINK4 " -v s6="$SINK6 " '
    index($0, a) == 1 { skip = 1; last = ""; next }
    index($0, b) == 1 { skip = 0; next }
    skip && index($0, s4) == 1 { last = $2; next }
    skip && index($0, s6) == 1 && $2 == last { next }
    { skip = 0; print }' "$1" 2>/dev/null
}
# hosts_strip src dst: src without our block, written to dst. Fails when awk
# is missing or failed, or when dst came out empty although src holds lines
# that are not ours: the caller then leaves the hosts file alone.
hosts_strip() {
  hosts_plain "$1" > "$2" || return 1
  [ -s "$2" ] && return 0
  ! grep -v -e "^$SINK4 " -e "^$SINK6 " -e "^$MARK_A" -e "^$MARK_B" "$1" 2>/dev/null | grep -q .
}

shield_block() {
  echo "$MARK_A"
  while read -r h _rest; do
    case "$h" in ""|\#*|*[!A-Za-z0-9.-]*) continue ;; esac
    echo "$SINK4 $h"; echo "$SINK6 $h"
  done < "$DIR/shield/hosts.txt"
  echo "$MARK_B"
}

counter_start() {
  counter_stop   # never two counters on the same ports
  if iptables -I OUTPUT -d "$SINK4" 2>/dev/null; then echo ipt > "$RUN/shield.count"; return 0; fi
  if command -v node >/dev/null 2>&1 && [ -r "$DIR/bin/shield-count.js" ]; then
    node "$DIR/bin/shield-count.js" "$RUN/shield.hits" "$SINK4" "$SINK6" >/dev/null 2>&1 </dev/null &
    echo "node $!" > "$RUN/shield.count"
  fi
}
counter_stop() {
  kind= pid=
  [ -r "$RUN/shield.count" ] && read -r kind pid < "$RUN/shield.count"
  [ "$kind" = ipt ] && iptables -D OUTPUT -d "$SINK4" 2>/dev/null
  [ "$kind" = node ] && is_num "$pid" && kill "$pid" 2>/dev/null
  rm -f "$RUN/shield.count" "$RUN/shield.hits"
}
shield_hits() {
  kind=
  [ -r "$RUN/shield.count" ] && read -r kind _pid < "$RUN/shield.count"
  if [ "$kind" = ipt ]; then iptables -L OUTPUT -v -n -x 2>/dev/null | grep -F "$SINK4" | head -n 1 | awk '{print $1}'
  elif [ "$kind" = node ]; then cat "$RUN/shield.hits" 2>/dev/null; fi
}

shield_on() {
  mkdir -p "$RUN"
  lock; shield_on_locked; sh_r=$?; unlock
  return "$sh_r"
}

shield_on_locked() {
  [ -r "$DIR/shield/hosts.txt" ] || { echo "error=nolist"; return 1; }
  if [ -e "$RUN/shield.on" ] || [ -e "$RUN/shield.mode" ]; then
    shield_off_quiet || { echo "error=busy"; return 1; }
  fi
  if hosts_mounted && [ -w "$HBC_HOSTS" ] && same_text "$HBC_HOSTS" "$ETC_HOSTS"; then
    # Homebrew Channel already keeps /etc/hosts in memory: add our lines to
    # its file in place (same inode, so the mount keeps showing it).
    # Written back only when the lines that were there came through whole.
    if hosts_strip "$HBC_HOSTS" "$RUN/hosts.new" && shield_block >> "$RUN/hosts.new"; then
      cat "$RUN/hosts.new" > "$HBC_HOSTS"
      echo inplace > "$RUN/shield.mode"
    fi
    rm -f "$RUN/hosts.new"
  else
    # The mount is on record only once it exists, so turning the shield off
    # never takes away a mount that is not ours.
    if hosts_strip "$ETC_HOSTS" "$RUN/hosts" && shield_block >> "$RUN/hosts" &&
       { mount --bind "$RUN/hosts" "$ETC_HOSTS" 2>/dev/null || mount -o bind "$RUN/hosts" "$ETC_HOSTS" 2>/dev/null; }; then
      echo bind > "$RUN/shield.mode"
    else
      rm -f "$RUN/hosts"
    fi
  fi
  if ! grep -q "^$MARK_A" "$ETC_HOSTS" 2>/dev/null; then
    shield_off_quiet; echo "error=nomount"; return 1
  fi
  counter_start
  mark "$RUN/shield.on"
  mkdir -p "$KEEP" 2>/dev/null && mark "$KEEP/shield.on"
  echo ok=1
}

# Takes our lines out again. Fails (and keeps the shield on record) when our
# own mount will not let go or the hosts file could not be rebuilt whole, so
# a later try can finish the job.
shield_off_quiet() {
  case "$(cat "$RUN/shield.mode" 2>/dev/null)" in
    inplace)
      if hosts_strip "$HBC_HOSTS" "$RUN/hosts.new"; then
        cat "$RUN/hosts.new" > "$HBC_HOSTS"; rm -f "$RUN/hosts.new"
      else
        rm -f "$RUN/hosts.new"; return 1
      fi ;;
    bind)
      if ! umount "$ETC_HOSTS" 2>/dev/null && grep -q "^$MARK_A" "$ETC_HOSTS" 2>/dev/null; then return 1; fi
      rm -f "$RUN/hosts" ;;
  esac
  counter_stop
  rm -f "$RUN/shield.mode" "$RUN/shield.on"
}
shield_off() {
  mkdir -p "$RUN"
  lock
  if shield_off_quiet; then rm -f "$KEEP/shield.on"; unlock; echo ok=1
  else unlock; echo "error=busy"; return 1; fi
}

# ---------- reads ----------

state() {
  echo "now=$(now)"
  echo "scene=$(cat "$RUN/scene.id" 2>/dev/null)"
  echo "target=$(cat "$RUN/scene.target" 2>/dev/null)"
  echo "end=$(cat "$RUN/scene.end" 2>/dev/null)"
  echo "sleep=$(cat "$RUN/sleep.until" 2>/dev/null)"
  echo "screenoff=$(cat "$RUN/screenoff.at" 2>/dev/null)"
  if [ -e "$RUN/shield.on" ]; then echo "shield=on"; echo "hits=$(shield_hits)"; else echo "shield=off"; fi
  echo "hosts=$(grep -c '^[A-Za-z0-9]' "$DIR/shield/hosts.txt" 2>/dev/null)"
  if keeper_alive; then echo "keeper=1"; else echo "keeper=0"; fi
}

vitals() {
  t=$(cat "$THERMAL" 2>/dev/null) || t=$(cat /proc/thermalinfo/soc_temperature 2>/dev/null)
  echo "temp=$t"
  echo "uptime=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
  mt=$(sed -n 's/^MemTotal: *\([0-9]*\).*/\1/p' /proc/meminfo 2>/dev/null)
  ma=$(sed -n 's/^MemAvailable: *\([0-9]*\).*/\1/p' /proc/meminfo 2>/dev/null)
  if [ -z "$ma" ]; then
    mf=$(sed -n 's/^MemFree: *\([0-9]*\).*/\1/p' /proc/meminfo 2>/dev/null)
    mc=$(sed -n 's/^Cached: *\([0-9]*\).*/\1/p' /proc/meminfo 2>/dev/null)
    is_num "$mf" && is_num "$mc" && ma=$((mf + mc))
  fi
  echo "memtotal=$mt"; echo "memavail=$ma"
  df -k -P "$DISK" 2>/dev/null | tail -n 1 | awk '{print "disktotal=" $2; print "diskused=" $3}'
}

logtail() {
  for f in $LOGS; do
    if [ -r "$f" ]; then tail -n 80 "$f"; return 0; fi
  done
  dmesg 2>/dev/null | tail -n 40
}

engine() {
  echo "@vitals"; vitals
  echo "@state"; state
  echo "@talk"; netstat -tnp 2>/dev/null
  echo "@log"; logtail
}

probe() {
  mkdir -p "$RUN"
  echo "exec=1"
  if capture "$RUN/probe.jpg"; then echo "capture=1"; else echo "capture=0"; fi
  rm -f "$RUN/probe.jpg"
  r=$(pic_read backlight)
  if ok "$r" && [ -n "$(printf '%s\n' "$r" | jget backlight)" ]; then echo "picture=1"; else echo "picture=0"; fi
  if ok "$(luna "$PWR/getPowerState" '{}')"; then echo "screenoff=1"; echo "sleep=1"; else echo "screenoff=0"; echo "sleep=0"; fi
  if is_num "$(vol_read)"; then echo "volume=1"; else echo "volume=0"; fi
  b=0
  if [ -r "$DIR/shield/hosts.txt" ]; then
    if hosts_mounted && [ -w "$HBC_HOSTS" ] && same_text "$HBC_HOSTS" "$ETC_HOSTS"; then b=1
    else
      # Try a bind mount on two scratch files; /etc is not touched.
      echo a > "$RUN/bind.a"; echo b > "$RUN/bind.b"
      if mount --bind "$RUN/bind.a" "$RUN/bind.b" 2>/dev/null || mount -o bind "$RUN/bind.a" "$RUN/bind.b" 2>/dev/null; then
        b=1; umount "$RUN/bind.b" 2>/dev/null
      fi
      rm -f "$RUN/bind.a" "$RUN/bind.b"
    fi
  fi
  echo "shield=$b"
  c=0
  iptables -L OUTPUT -n >/dev/null 2>&1 && c=1
  command -v node >/dev/null 2>&1 && c=1
  echo "count=$c"
  l=0
  for f in $LOGS; do [ -r "$f" ] && l=1; done
  echo "log=$l"
  if [ -r "$THERMAL" ] || [ -r /proc/thermalinfo/soc_temperature ]; then echo "temp=1"; else echo "temp=0"; fi
}

# ---------- the keeper ----------

keeper_alive() {
  p=$(cat "$RUN/keeper.pid" 2>/dev/null)
  is_num "$p" && kill -0 "$p" 2>/dev/null
}

keeper_ensure() {
  mkdir -p "$RUN"
  keeper_alive && return 0
  ( exec sh "$0" keeper ) >/dev/null 2>&1 </dev/null &
}

# After a restart /tmp is empty but $KEEP may still hold the picture values
# and volume from before an interrupted scene: queue them, and put the shield
# back.
recover() {
  mkdir -p "$RUN"
  for f in "$KEEP"/orig.*; do
    [ -s "$f" ] || continue
    t=${f##*/orig.}
    safe_id "$t" || continue
    [ -e "$RUN/orig.$t" ] && continue
    cp "$f" "$RUN/orig.$t" && mark "$RUN/pending.$t"
  done
  if [ -s "$KEEP/vol" ] && [ ! -e "$RUN/vol" ]; then
    cp "$KEEP/vol" "$RUN/vol" && echo 0 > "$RUN/vol.tries"
  fi
  if [ -e "$KEEP/shield.on" ] && [ ! -e "$RUN/shield.on" ]; then shield_on >/dev/null; fi
}

# Follows the app in front without polling: one subscription, one line per
# change. It belongs to one keeper ($1 = its pid) and ends when that keeper
# is no longer the one on record.
follow() {
  while [ "$(cat "$RUN/keeper.pid" 2>/dev/null)" = "$1" ]; do
    luna-send -i "$SAM/getForegroundAppInfo" '{"subscribe":true}' 2>/dev/null </dev/null |
      while read -r line; do
        [ "$(cat "$RUN/keeper.pid" 2>/dev/null)" = "$1" ] || exit 0
        id=$(printf '%s\n' "$line" | jget appId)
        safe_id "$id" || continue
        echo "$id" > "$RUN/front.new" && mv "$RUN/front.new" "$RUN/front"
        case "$id" in "$APP"|"$STOCK") ;; *) echo "$id" > "$RUN/last" ;; esac
      done
    # The subscription ended: the note is no longer kept current, so the
    # helper asks the TV directly until it is back.
    rm -f "$RUN/front"
    sleep 5
  done
}

# The sleep timer reached zero: end the scene, put its picture back, then a
# normal power-off. The notice put Impetus in front, so the scene's target is
# brought forward first: picture values can only go back to the input showing.
power_down() { # the hour the timer was set for
  lock
  # Cancelled or replaced while this turn waited for the lock: leave the TV on.
  if [ "$(cat "$RUN/sleep.until" 2>/dev/null)" != "$1" ]; then unlock; return 0; fi
  pd_n=$(cat "$RUN/standby.tries" 2>/dev/null); is_num "$pd_n" || pd_n=0
  pd_t=$(cat "$RUN/scene.target" 2>/dev/null)
  scene_off_locked
  if safe_id "$pd_t" && [ -e "$RUN/pending.$pd_t" ]; then
    launch "$pd_t"
    pd_i=0
    while [ "$pd_i" -lt 8 ] && [ "$(front_now)" != "$pd_t" ]; do sleep 1; pd_i=$((pd_i + 1)); done
    [ "$(front_now)" = "$pd_t" ] && restore_target "$pd_t"
  fi
  if standby; then
    rm -f "$RUN/standby.tries"
  else
    # The TV took none of the power calls: ask again on the next turns, 5 at most.
    pd_n=$((pd_n + 1))
    if [ "$pd_n" -lt 5 ]; then
      echo "$pd_n" > "$RUN/standby.tries"; echo "$1" > "$RUN/sleep.until"; mark "$RUN/sleep.noticed"
    else
      rm -f "$RUN/standby.tries"
    fi
  fi
  unlock
}

tick() {
  n=$(now)
  u=$(cat "$RUN/sleep.until" 2>/dev/null)
  if is_num "$u"; then
    if [ "$n" -ge "$u" ]; then
      power_down "$u"
    elif [ "$n" -ge $((u - NOTICE)) ] && [ ! -e "$RUN/sleep.noticed" ]; then
      mark "$RUN/sleep.noticed"
      f=$(front)
      [ "$f" != "$APP" ] && safe_id "$f" && echo "$f" > "$RUN/sleep.prev"
      launch "$APP" "{\"notice\":\"sleep\",\"until\":$u}"
    fi
  fi
  e=$(cat "$RUN/scene.end" 2>/dev/null)
  if is_num "$e" && [ "$n" -ge "$e" ]; then lock; scene_off_locked; unlock; fi
  s=$(cat "$RUN/screenoff.at" 2>/dev/null)
  if is_num "$s" && [ "$n" -ge "$s" ]; then
    rm -f "$RUN/screenoff.at"
    t=$(cat "$RUN/scene.target" 2>/dev/null)
    [ "$(front)" = "$t" ] && screen_off
    # A scene that only turns the screen off has nothing left to undo.
    if [ ! -e "$RUN/scene.apply" ] && [ ! -s "$RUN/scene.night" ] && [ ! -s "$RUN/sleep.until" ] &&
       [ ! -s "$RUN/vol" ] && { ! safe_id "$t" || [ ! -e "$RUN/orig.$t" ]; }; then scene_clear; fi
  fi
  # A volume that could not be put back when its scene ended (or was found
  # after a restart) is tried again while no scene is on.
  if [ -e "$RUN/vol.tries" ] && [ ! -e "$RUN/scene.id" ]; then lock; vol_restore; unlock; fi
  lock; due; unlock
}

keeper() {
  mkdir -p "$RUN"
  keeper_alive && exit 0
  echo $$ > "$RUN/keeper.pid"
  recover
  follow $$ &
  kp_follow=$!
  echo "$kp_follow" > "$RUN/follow.pid"
  # It only ever removes its own record: by the time an old keeper ends, a
  # new one may already be the keeper on record.
  trap 'keeper_end' TERM INT
  kp_i=0
  while [ "$(cat "$RUN/keeper.pid" 2>/dev/null)" = "$$" ]; do
    tick
    [ $((kp_i % 20)) -eq 0 ] && still_keep   # at once, then about once a minute
    kp_i=$((kp_i + 1))
    sleep 3
  done
  keeper_end
}

keeper_end() {
  unlock   # a turn that was stopped half-way gives its lock back
  kill "$kp_follow" 2>/dev/null
  if [ "$(cat "$RUN/keeper.pid" 2>/dev/null)" = "$$" ]; then rm -f "$RUN/keeper.pid" "$RUN/follow.pid" "$RUN/front"; fi
  exit 0
}

keeper_stop() {
  p=$(cat "$RUN/keeper.pid" 2>/dev/null)
  is_num "$p" && kill "$p" 2>/dev/null
  p=$(cat "$RUN/follow.pid" 2>/dev/null)
  is_num "$p" && kill "$p" 2>/dev/null
  rm -f "$RUN/keeper.pid" "$RUN/follow.pid" "$RUN/front"
}

# The way back. Picture values belong to an input, so each waiting set is put
# back with its own app in front; the last one stays in front. A set whose
# app will not come to the front is never written to another input: its
# record stays in $KEEP and the answer names it.
restore_all() {
  mkdir -p "$RUN"
  keeper_stop
  # A lock the stopped keeper left is taken over at once (its holder is
  # gone); a verb still at work is waited for.
  lock
  for f in "$KEEP"/orig.*; do
    [ -s "$f" ] || continue
    t=${f##*/orig.}
    safe_id "$t" && [ ! -e "$RUN/orig.$t" ] && cp "$f" "$RUN/orig.$t"
  done
  [ -s "$RUN/vol" ] || cp "$KEEP/vol" "$RUN/vol" 2>/dev/null
  scene_clear
  vol_restore || { sleep 1; vol_restore; } || { sleep 1; vol_restore; }
  rm -f "$RUN/vol" "$RUN/vol.tries" "$KEEP/vol"
  unlock
  ra_left=""
  for f in "$RUN"/orig.*; do
    [ -e "$f" ] || continue
    t=${f##*/orig.}
    safe_id "$t" || continue
    launch "$t"
    i=0
    while [ "$i" -lt "$FRONTWAIT" ] && [ "$(front_now)" != "$t" ]; do sleep 1; i=$((i + 1)); done
    if [ "$(front_now)" = "$t" ]; then
      restore_target "$t" || { sleep 1; restore_target "$t"; } || { sleep 1; restore_target "$t"; } ||
        ra_left="$ra_left $t"
    else
      mark "$RUN/pending.$t"
      ra_left="$ra_left $t"
    fi
  done
  rm -f "$RUN"/tries.*
  lock
  if shield_off_quiet; then rm -f "$KEEP/shield.on"; else ra_left="$ra_left hosts"; fi
  unlock
  if [ -n "$ra_left" ]; then echo "error=notrestored$ra_left"; return 1; fi
  echo ok=1
}

# ---------- verbs ----------

for a in "$@"; do safe "$a" || die word; done
[ -n "$DIR" ] || die dir

verb=$1
[ $# -gt 0 ] && shift
case "$verb" in
  probe) probe ;;
  start)
    mkdir -p "$RUN"
    for a in "$@"; do
      case "$a" in target=*) safe_id "${a#target=}" && echo "${a#target=}" > "$RUN/still.target" ;; esac
    done
    keeper_ensure; echo ok=1 ;;
  state) state ;;
  still) still "$1" ;;
  scene)
    sub=$1
    [ $# -gt 0 ] && shift
    case "$sub" in on) scene_on "$@" ;; off) scene_off ;; *) die scene ;; esac ;;
  sleep)
    [ "$1" = cancel ] || die sleep
    mkdir -p "$RUN"
    lock
    echo "prev=$(cat "$RUN/sleep.prev" 2>/dev/null)"
    rm -f "$RUN/sleep.until" "$RUN/sleep.noticed" "$RUN/sleep.prev" "$RUN/standby.tries"
    unlock ;;
  shield) case "$1" in on) shield_on ;; off) shield_off ;; *) die shield ;; esac ;;
  engine) engine ;;
  restore) restore_all ;;
  keeper) keeper ;;
  tick) mkdir -p "$RUN"; tick; echo ok=1 ;;
  *) die verb ;;
esac
