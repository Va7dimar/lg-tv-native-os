        path = _outer_targz(
            self.fx / "outer.tar.gz",
            {tcp.KERNEL_MEMBER: kernel, tcp.BOOTCODE_MEMBER: boot},
        )
        data = path.read_bytes()
        spec = tcp.PhaseSpec.for_tests(
            outer_name="outer.tar.gz",
            outer_bytes=len(data),
            outer_sha256=_sha256(data),
