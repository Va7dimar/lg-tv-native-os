+def _inventory_inner(
+    staged: Path,
+    output_dir: Path,
+    limits: PhaseLimits,
+    budgets: PhaseBudgets,
+    clock: Callable[[], float],
+    deadline: float,
+) -> tuple[dict, list[str], str]:
+    errors: list[str] = []
+    members: list[dict] = []
+    archive = {
+        "filename": staged.name,
+        "status": "ok",
+        "error": None,
+        "member_count": 0,
+        "members": members,
