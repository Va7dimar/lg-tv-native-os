+def _normalize_stdio():
+    # Reserve standard slots before allocating any host bind descriptors.
+    for n in range(3):
+        try:
+            os.fstat(n)
+        except OSError as e:
+            if e.errno != errno.EBADF:
+                raise
+            fd = os.open(os.devnull, os.O_RDWR)
+            if fd != n:
+                try:
+                    os.dup2(fd, n)
+                finally:
+                    os.close(fd)
+
