+    def test_dot_slash_prefixed_regular_member_is_selected(self):
+        cases = [('./a', 'a', b'hello'), ('./dir/text', 'dir/text', b'nested')]
+        for raw, requested, payload in cases:
+            with self.subTest(raw=raw):
+                specs = self.fixture.specs(fixtures.tar_bytes([(raw, payload)]))
+                doc, out, rows = self.run_selected(
+                    [self.selector(path=requested, size=len(payload))], specs)
+                self.assertTrue(doc['ok'], doc)
+                selected = next(r for r in rows if r['selected'])
+                self.assertEqual(selected['raw_name'], raw)
+                self.assertEqual(selected['canonical_name'], requested)
+                self.assertEqual(selected['size'], len(payload))
+                self.assertEqual(selected['content_sha256'], hashlib.sha256(payload).hexdigest())
+                data_path = selected['output_data_path']
+                self.assertEqual(Path(data_path).name, data_path)
+                self.assertEqual((out / data_path).read_bytes(), payload)
+                self.assertEqual((out / data_path).stat().st_mode & 0o777, 0o600)
+
